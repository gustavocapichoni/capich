{
  "version": 2,
  "regions": ["gru1"],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/sobre",
      "destination": "/sobre.html"
    },
    {
      "source": "/metodo",
      "destination": "/metodo.html"
    },
    {
      "source": "/crypto_trading_history",
      "destination": "/crypto_trading_history.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-accumulate",
      "schedule": "0 0 * * *"
    }
  ]
}
